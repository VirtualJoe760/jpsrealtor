# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Creative files
/photoshop

# photos to upload to cloudinary
/post-photos

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
# NOTE: the patterns above all require a leading dot, so a dotless `env.local`
# was NOT ignored and sat untracked in the repo — one `git add -A` from public.
env.local
env
env.*
!env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.codegpt


# Ingore Local Logs Folder
/local-logs
/src/generated/prisma

# PWA files
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/sw.js.map
**/public/workbox-*.js.map
**/public/worker-*.js.map

# Test page (exclude from build)
/src/app/test

# California county GeoJSON data (intermediate build file)
ca_counties.json

.env*.local

# Video files
*.mp4

# API credential files (e.g. GSC service-account JSON used by mcp-gsc).
# Live at src/.credentials/ — never commit any contents of that folder.
gsc-credentials.json
*-credentials.json
/src/.credentials/

# Finance / fundraising materials (private — investor lists, business model, game plan)
/finance

temp-images/
.dev-server.log

# GCP service-account keys — credentials, never committed
.gcp/

# Scratch space for scaffolding a create-chatrealty-site build and driving it in
# the browser. The preview tooling refuses a cwd outside the project root, so a
# generated site has to live here to be verified rather than merely built.
/.local-preview/

# Local scaffolder smoke-test site (repairer loop). Never committed.
.scaffold-check/
