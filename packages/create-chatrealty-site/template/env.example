# ChatRealty API — used SERVER-SIDE ONLY (never exposed to the browser).
# `create-chatrealty-site` writes your real values into .env.local for you.
# Get a token from Settings → Integrations on your ChatRealty site.
CHATREALTY_API_TOKEN=crt_live_your_token_here
CHATREALTY_API_BASE=https://www.chatrealty.io

# Identity overrides (optional). The site's name, license, brokerage, bio and
# service areas normally come from the ChatRealty profile the token belongs to.
# Set any of these and that field wins instead — useful when you're building for
# someone other than the token holder, or when the interview turned up a license
# number or brokerage the profile doesn't have yet. Unset vars change nothing.
# AGENT_SERVICE_AREAS drives the /neighborhoods index, so set it for a
# single-market site whose token can see more than that market.
# Note: `set_site_live` checks the license on the ChatRealty PROFILE, so an
# override here shows on the site but does not unblock go-live.
# AGENT_NAME=
# AGENT_LICENSE=
# AGENT_BROKERAGE=
# AGENT_PHONE=
# AGENT_EMAIL=
# AGENT_WEBSITE=
# AGENT_HEADLINE=
# AGENT_TAGLINE=
# AGENT_BIO=
# AGENT_HEADSHOT=
# AGENT_SERVICE_AREAS=La Quinta,Palm Desert,Indian Wells
# AGENT_SPECIALIZATIONS=Luxury,Vacation rentals

# CHAP — the on-site property chat. BYOK: any OpenAI-compatible provider.
# Groq (console.groq.com) is the recommended default. The widget hides itself
# until a key is set. SERVER-SIDE ONLY.
# CHAT_API_KEY=gsk_your_key_here
# CHAT_MODEL=llama-3.3-70b-versatile
# CHAT_BASE_URL=https://api.groq.com/openai/v1

# Cloudflare Turnstile (optional) — bring your OWN keys to gate the inquiry
# form with a bot check. Get them at dash.cloudflare.com → Turnstile (free).
# Set BOTH to enable: the site key renders the widget, the secret verifies
# server-side in /api/lead. Leave unset and the form still has honeypot +
# rate-limit protection.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_your_site_key
# TURNSTILE_SECRET_KEY=0x4AAAAAAA_your_secret_key

# Auth.js — visitor sign-in. AUTH_SECRET is generated for you at scaffold time.
# Social login (optional): create YOUR OWN OAuth apps and the buttons appear
# automatically. Redirect URIs: {your-origin}/api/auth/callback/google and
# {your-origin}/api/auth/callback/facebook
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=
